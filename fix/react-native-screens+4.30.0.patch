+/// `fitToContents`: UIKit adds the bottom safe area to custom detent values, while the content height already
+/// includes whatever bottom inset the content applies. Subtract it, so the sheet is exactly as tall as its content.
+- (NSArray<UISheetPresentationControllerDetent *> *)detentsFromContentHeight:(CGFloat)contentHeight
+    API_AVAILABLE(ios(16.0))
+{
+  __weak RNSScreenView *weakSelf = self;
+  return [self
+      detentsFromValues:@[ @(contentHeight) ]
+           withResolver:^CGFloat(id<UISheetPresentationControllerDetentResolutionContext> ctx, NSNumber *height) {
+             CGFloat bottomInset = weakSelf.window.safeAreaInsets.bottom;
+             return MIN(ctx.maximumDetentValue, MAX(0, height.floatValue - bottomInset));
+           }];
+}
